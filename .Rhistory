rm(list = ls())
library(dslabs)
my_first <- "SUDE"
my_birth_year <- 2004
k <- (nchar(my_first) + my_birth_year) %% 15 + 8
if (k %% 2) {
print(tail(polls_us_election_2016, k))
} else {
print(head(polls_us_election_2016, k))
}
#total number of NA calculation
total_na <- sum(is.na(polls_us_election_2016))
print(total_na)
#NA per column (I had some help from AI)
na_per_column <- sort(colSums(is.na(polls_us_election_2016)), decreasing = TRUE)
print(na_per_column)
